# Copy to .env for local development. Never commit .env.
# On Render, set these in the service's Environment tab instead.

# --- Core ---
SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (Supabase Postgres) ---
# Leave DB_NAME blank to use local SQLite.
# Supabase dashboard -> Connect -> "Session pooler" gives these values.
# Use the POOLER host (aws-0-<region>.pooler.supabase.com), not db.<ref>.supabase.co:
# Render only has IPv4 and the direct host is IPv6-only.
DB_NAME=postgres
DB_USER=postgres.<your-project-ref>
DB_PASSWORD=
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require

# --- JWT ---
ACCESS_TOKEN_LIFETIME_MIN=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS / CSRF (comma-separated, no trailing slashes) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=

# --- Misc ---
TIME_ZONE=Africa/Nairobi
